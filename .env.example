# ==============================================================================
# Luna 統一環境變數設定檔範例 (.env.example)
#
# 使用方式：
#   1. 複製此範本檔案為 .env：
#      cp .env.example .env
#   2. 根據需求填入實際數值與金鑰
#   3. .env 檔案受 .gitignore 保護，切勿提交至版本控制庫
#
# 本設定檔依五大邏輯分層 (Logical Tiers) 組織：
#   Section 1: Luna Host Core 核心設定 (Discord Bot 與認證核心)
#   Section 2: Curtly URL Shortener & Web Dashboard 短網址與控制台
#   Section 3: Summarizer & Multimodal Pipeline 摘要與多模態管線
#   Section 4: Plugin Lifecycle & Management 外掛生命週期管理
#   Section 5: Multi-Tenant Gemini MCP Server 多租戶 Gemini MCP 伺服器 (:mcp-server)
# ==============================================================================


# ==============================================================================
# Section 1: Luna Host Core 核心設定 (Discord Bot & Web Host)
# ==============================================================================

# [必填] Discord 機器人 Token
# 取得途徑：Discord Developer Portal -> Applications -> [你的 App] -> Bot -> Reset Token
# 安全警示：此金鑰具備完整機器人操作權限，系統啟動日誌會自動將其遮蔽為 '******'
DISCORD_TOKEN=your_discord_bot_token_here

# [必填] Discord Application / Client ID
# 取得途徑：Discord Developer Portal -> Applications -> [你的 App] -> General Information -> APPLICATION ID
# 說明：用於 Discord OAuth2 登入驗證流程與斜線指令註冊 (相容別名：DISCORD_APP_ID)
DISCORD_CLIENT_ID=your_discord_client_id_here

# [必填] Discord OAuth2 Client Secret
# 取得途徑：Discord Developer Portal -> Applications -> [你的 App] -> OAuth2 -> General -> Reset Secret
# 用於 Web 控制台使用者身分授權換取 Token，系統啟動日誌會自動將其遮蔽為 '******'
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# [選填] Discord OAuth2 重導向回呼網址 (Redirect URI)
# 預設值：由 BASE_URL 自動推導為 http://localhost:8080/api/auth/discord/callback
# 注意事項：必須與 Discord Developer Portal -> OAuth2 -> Redirects 清單中的設定完全相符
# 若部署於雲端或自訂網域，請修改為對應網址 (例如 https://yourdomain.com/api/auth/discord/callback)
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# [選填] Luna Web 控制台與 HTTP 伺服器通訊埠
# 預設值：8080
# 邊界限制：有效範圍為整數 1-65535。若非整數或超出範圍，系統啟動時將立即拋出 ConfigValidationException 中斷
# Docker Compose 說明：映射至主機通訊埠 ${PORT:-8080}:8080
PORT=8080


# ==============================================================================
# Section 2: Curtly URL Shortener & Web Dashboard 短網址與控制台
# ==============================================================================

# [選填] 短網址對外公開基底網域 (Base URL)
# 預設值：http://localhost:8080/s/
# 說明：生成之短網址前綴 (例如 http://localhost:8080/s/xyz)。亦用於推導預設之 OAuth2 回呼網址
# 雙命名空間：亦可透過 curtly.baseUrl 或 PLUGINS_CURTLY_BASE_URL 於 application.yml 設定
# 若使用自訂網域或反向代理，請設定為例如 https://yourdomain.com/s/
BASE_URL=http://localhost:8080/s/


# ==============================================================================
# Section 3: Summarizer & Multimodal Pipeline 摘要與多模態管線
# ==============================================================================

# [選填] Google Gemini API 金鑰
# 取得途徑：Google AI Studio (https://aistudio.google.com/)
# 用途：驅動 AI 對話上下文回溯摘要、多模態影片重點提取與圖片理解。若未設定則停用 AI 摘要功能
# 安全警示：系統啟動日誌會自動將其遮蔽為 '******'
GEMINI_API_KEY=your_gemini_api_key_here

# [選填] Google Gemini 模型識別碼
# 預設值：gemini-3.5-flash-lite
# 說明：指定呼叫 Google Generative Language API 的模型版本
GEMINI_MODEL=gemini-3.5-flash-lite

# [選填] Google Generative Language API 基底網址 (Base URL)
# 預設值：https://generativelanguage.googleapis.com
# 說明：Google Gemini API 呼叫端點，可於自訂反向代理、專有端點或測試 Mock 伺服器環境中覆寫
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# [選填] 社群閒聊對話生成之 Google Gemini 模型版本 (Chatter)
# 預設值：gemini-3.5-flash-lite
# 說明：指定 luna.chatter 對話回覆產生器調用之 Google Gemini 模型版本 (未設定時亦可繼承 GEMINI_MODEL)
CHATTER_GEMINI_MODEL=gemini-3.5-flash-lite

# [選填] Google Search Grounding 搜尋佐證與名詞查核開關
# 預設值：true
# 說明：啟用後，Gemini 將依對話內容自主決定是否調用 Google 搜尋以查核事實與解釋專有名詞
GEMINI_SEARCH_GROUNDING_ENABLED=true

# [選填] Google Cloud YouTube Data API v3 金鑰
# 取得途徑：Google Cloud Console 啟用 YouTube Data API v3
# 用途：抓取 YouTube 影片時長、時間軸章節、作者說明與熱門觀眾留言以注入摘要上下文
# 平滑降級：若未設定，系統將自動平滑降級為 oEmbed 模式提取基本資訊，不影響基本摘要運作
# 安全警示：系統啟動日誌會自動將其遮蔽為 '******'
YOUTUBE_API_KEY=your_youtube_api_key_here

# [選填] 觸發 AI 摘要的 Discord Reaction 表情符號
# 預設值：📝
# 說明：使用者在 Discord 訊息添加此 Emoji 時，將自動觸發該訊息與對話串的 AI 摘要流程
SUMMARY_EMOJI=📝

# [選填] AI 摘要向上回溯的訊息數量上限
# 預設值：50
# 邊界限制：有效範圍為整數 1-100（對齊 Discord 單頁 REST API 上限，數值會自動被限制在此區間）
# 說明：雙邊界回溯演算法向上檢索對話脈絡時的最大訊息則數
SUMMARY_MAX_HISTORY_MESSAGES=50

# [選填] AI 摘要歷史回溯中斷的閒置時間門檻 (分鐘)
# 預設值：15
# 邊界限制：正整數（單位為分鐘）
# 說明：當回溯過程中發現兩則相鄰訊息間隔超過此時間，視為冷話題中斷點並停止回溯
SUMMARY_INACTIVITY_GAP_MINUTES=15

# [選填] AI 摘要歷史訊息累計字元預算上限
# 預設值：20000
# 邊界限制：正整數（需大於 0）
# 說明：歷史對話累計字元總數上限防護，防止惡意洗版造成 Prompt 膨脹或消耗過多 Token
SUMMARY_MAX_CHARACTER_BUDGET=20000

# [選填] AI 摘要即時脈絡回溯訊息數量上限
# 預設值：20
# 邊界限制：有效範圍為整數 1-20（數值會自動限制在 1 至 20 之間）
# 說明：目標訊息前方保留的即時對話訊息上限，確保上下文焦點集中
SUMMARY_MAX_LOOKBACK_MESSAGES=20

# [選填] 聊天圖片多模態理解擷取圖片數量上限
# 預設值：10
# 邊界限制：正整數（需大於 0）
# 說明：從 Discord 訊息附件與 CDN 連結中擷取的圖片最大數量。若超出上限將優先保留切片內最新的圖片
SUMMARY_MAX_IMAGES=10


# ==============================================================================
# Section 3.1: Chatter & Laya Studio System 1 Decision Client 自主閒聊與決策
# ==============================================================================

# [選填] 雲端 Laya Studio API Bearer 金鑰
# 取得途徑：https://api.laya.studio
# 說明：用於 System 1 (POST /v1/systemone) 二元 (noul) 對話參與意願快速判定
LAYA_API_KEY=your_laya_api_key_here

# [選填] Laya System 1 決策門檻 (0.0 - 1.0)
# 預設值：0.7
# 說明：當 Laya 判定 noul == true 且機率大於等於此門檻時才觸發 AI 參與對話
LAYA_THRESHOLD=0.7

# [選填] Laya Studio API 決策端點網址
# 預設值：https://api.laya.studio/v1/systemone
# 說明：System 1 決策端點 URL
LAYA_ENDPOINT=https://api.laya.studio/v1/systemone

# [選填] Laya Studio API 請求超時時間 (秒)
# 預設值：10
LAYA_TIMEOUT_SECONDS=10

# [選填] 是否啟用 Chatter 自動參與社群閒聊
# 預設值：true (當 LAYA_API_KEY 已設定時)
CHATTER_ENABLED=true

# [選填] Chatter 允許參與之 Discord 頻道 ID 清單 (以逗號分隔，留空表示允許所有頻道)
CHATTER_ALLOWED_CHANNELS=

# [選填] Chatter 頻道冷卻時間 (秒)
# 預設值：30
CHATTER_COOLDOWN_SECONDS=30


# ==============================================================================
# Section 4: Plugin Lifecycle & Management 外掛生命週期管理
# ==============================================================================
# Luna 內建模組化外掛 (名稱不區分大小寫)：
#   - chatter       : 基於 Laya Studio System 1 決策與 Gemini 之 Discord 頻道自主閒聊回覆
#   - curtly        : 短網址縮短服務、多維度點擊分析與 Web 玻璃擬態控制台
#   - mcp           : 多租戶 Model Context Protocol 客戶端憑證與 Webhook 管理 (/mcp 斜線指令)
#   - social-preview: 跨平台社群貼文 (Threads, Bilibili, Reddit, YouTube, FB, X, IG) 預覽
#   - summarizer    : 對話雙邊界回溯、多模態圖片與 YouTube 深度 AI 摘要管線
#   - undercover    : 誰是臥底文字派對互動遊戲 (支援 Discord Slash 指令與互動式表決)

# [選填] 整批停用外掛清單 (以逗號分隔)
# 說明：被列入的外掛不會被初始化，亦不會註冊任何事件監聽器或斜線指令
# 範例：PLUGINS_DISABLED=undercover,curtly
# PLUGINS_DISABLED=undercover,curtly

# [選填] 各外掛獨立啟用開關 (PLUGINS_<NAME>_ENABLED)
# 預設值：true (所有外掛預設啟用)
# 說明：設為 false 即可個別關閉特定外掛之生命週期載入
# PLUGINS_CHATTER_ENABLED=true
# PLUGINS_CURTLY_ENABLED=true
# PLUGINS_MCP_ENABLED=true
# PLUGINS_SOCIAL_PREVIEW_ENABLED=true
# PLUGINS_SUMMARIZER_ENABLED=true
# PLUGINS_UNDERCOVER_ENABLED=true


# ==============================================================================
# Section 5: Multi-Tenant Gemini MCP Server 多租戶 Gemini MCP 伺服器 (:mcp-server)
# ==============================================================================
# :mcp-server 為獨立運行的 Model Context Protocol (MCP) 與 OAuth 2.1 伺服器模組，
# 提供 Google Gemini / Claude 等 AI 助理透過標準 MCP 工具安全調用 Luna 機器人功能。
# 在 Docker Compose 環境中由 luna-mcp-server 服務獨立運行，與主機器人共用資料庫磁區。
#
# 多租戶動態客戶端工作流程 (Multi-Tenant Dynamic Client Workflow - ADR 0008)：
#   1. 自助式憑證開通 (Self-Service Client Issuance)：
#      Discord 成員不需管理員預先設定伺服器金鑰，可直接於任何 Discord 頻道輸入斜線指令：
#        /mcp client create [name]
#      系統即時生成專屬 Client ID (格式：luna_cli_<random>) 與 32 位元組隨機 Client Secret，
#      並以 Ephemeral (僅自己可見) 訊息提供 Google Gemini Apps / Custom Actions 串接步驟。
#      相關指令：/mcp client show (查看 ID 與配額), /mcp client reset-secret (旋轉密鑰), /mcp client revoke (撤銷憑證)。
#   2. 頻道 Webhook 綁定與標籤化管理 (Tagged Webhooks)：
#      每個客戶端最多可綁定 10 組頻道 Webhook (硬性配額上限：10)，並透過 tag 標籤唯一識別：
#        /mcp webhook add tag:<tag> [url:<url>]
#      - 若未提供 url，Luna 機器人將自動透過 Discord REST API 於當前頻道自動建立 Webhook。
#      - tag 限制為 1-32 個字元且不可包含空白。
#      相關指令：/mcp webhook list (列出標籤清單與 10 組配額狀態), /mcp webhook remove tag:<tag> (移除 Webhook)。
#   3. MCP 工具調用與租戶隔離 (Tool Dispatch)：
#      - send_discord_message(content, target)：指定 target 為特定 tag (路由至該頻道) 或 "all" (全體廣播)。
#      - list_targets：供 AI 助理即時探索目前帳號已綁定之 Webhook 標籤清單與配額使用量 (x/10)。
#   4. 多程序資料庫並發 (Multi-Process SQLite Concurrency)：
#      Luna 主機器人 (:root) 與 MCP 伺服器 (:mcp-server) 共同存取 SQLite 資料庫，
#      啟用 PRAGMA journal_mode=WAL; 與 PRAGMA busy_timeout=5000;，確保即時 Token 撤銷與並發寫入安全。

# ------------------------------------------------------------------------------
# 5.1 MCP 伺服器基礎架構設定 (Core Infrastructure)
# ------------------------------------------------------------------------------

# [選填] MCP 伺服器 HTTP / SSE 監聽通訊埠
# 預設值：8081
# 邊界限制：有效範圍為整數 1-65535。若非整數或超出範圍，啟動時將立即拋出 McpConfigValidationException 中斷
# Docker Compose 說明：映射至主機通訊埠 ${MCP_PORT:-8081}:8081
MCP_PORT=8081

# [選填] MCP 伺服器存取之 SQLite 資料庫檔案路徑
# 預設值：./.data/luna.db
# 說明：與 Luna 主機器人共用之 SQLite 資料庫檔案路徑 (支援 PRAGMA journal_mode=WAL)。
# 在 Docker 容器內掛載為 /app/.data/luna.db
MCP_DB_PATH=./.data/luna.db

# [選填] MCP 伺服器對外公開基底網址 (Public Base URL)
# 預設值：https://woodendoor.website
# 說明：用於 OAuth 2.1 端點探索 (/.well-known/oauth-authorization-server)、
# Gemini OAuth 重導向驗證 (https://oauth-redirect.googleusercontent.com/r/*) 與 SSE 連線
MCP_PUBLIC_BASE_URL=https://woodendoor.website
