# ==========================================
# Luna 運行環境變數設定檔範例
# 請複製此檔案為 .env 並填入實際數值
# ==========================================

# [必填] Discord 機器人 Token (由 Discord Developer Portal 取得)
DISCORD_TOKEN=your_discord_bot_token_here

# [必填] Discord Application / Client ID (OAuth2 登入用)
DISCORD_CLIENT_ID=your_discord_client_id_here

# [必填] Discord Client Secret (OAuth2 登入用)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# [選填] OAuth2 回呼網址 (預設為 http://localhost:8080/api/auth/discord/callback)
# 若部署於雲端或有自訂網域，請更換為對應網址 (需與 Discord Developer Portal Redirects 一致)
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# [選填] 短網址基底網域 (預設為 http://localhost:8080/s/)
# 若有自訂網域，請設定為例如 https://yourdomain.com/s/
BASE_URL=http://localhost:8080/s/

# [選填] Web 控制台與短網址重導向監聽通訊埠 (預設 8080)
PORT=8080


# [選填] Google Gemini API Key (用於反應觸發 AI 摘要功能)
GEMINI_API_KEY=your_gemini_api_key_here

# [選填] Google Gemini 模型名稱 (預設為 gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# [選填] YouTube Data API v3 Key (用於獲取 YouTube 影片時長與觀眾留言，若未設定則自動平滑降級為 oEmbed 模式)
YOUTUBE_API_KEY=your_youtube_api_key_here

# [選填] 觸發 AI 摘要的 Emoji (預設為 📝)
SUMMARY_EMOJI=📝

# [選填] AI 摘要回溯擷取的對話上下文訊息上限 (預設 50，有效範圍 1-100)
SUMMARY_MAX_HISTORY_MESSAGES=50

# [選填] AI 摘要歷史回溯中斷的閒置時間間隔 (分鐘，預設 15，超過此間隔視為冷話題停止回溯)
SUMMARY_INACTIVITY_GAP_MINUTES=15

# [選填] AI 摘要歷史訊息累計字元上限保護 (預設 20000，防止惡意刷屏造成 Prompt 膨脹)
SUMMARY_MAX_CHARACTER_BUDGET=20000

# ==========================================
# 外掛啟用 / 關閉設定 (Plugin Management)
# ==========================================
# Luna 內建 4 大外掛 (名稱不分大小寫)：
#   - curtly        : 短網址服務與 Web 控制台
#   - social-preview: 社群媒體貼文即時解析與 Embed 預覽
#   - summarizer    : 對話回溯與 YouTube 多模態 AI 摘要
#   - undercover    : 誰是臥底文字派對遊戲
#
# 方式一：整批停用清單 (逗號分隔外掛名稱，推薦快速關閉多個外掛)
# plugins.disabled=undercover,curtly
# 或 Docker 環境變數格式：
# PLUGINS_DISABLED=undercover,curtly

# 方式二：個別外掛開關 (設為 false 即可完全關閉該外掛之生命週期與事件監聽)
# plugins.curtly.enabled=false
# plugins.social-preview.enabled=false
# plugins.summarizer.enabled=false
# plugins.undercover.enabled=false
# 或 Docker 環境變數格式 (PLUGINS_<NAME>_ENABLED=false)：
# PLUGINS_CURTLY_ENABLED=false
# PLUGINS_SOCIAL_PREVIEW_ENABLED=false
# PLUGINS_SUMMARIZER_ENABLED=false
# PLUGINS_UNDERCOVER_ENABLED=false

